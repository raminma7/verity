# Copy to apps/api/.env for local runs. Every setting is VERITY_<NAME>; see apps/api/app/core/config.py.
VERITY_ENV=dev
VERITY_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/verity
VERITY_REDIS_URL=redis://localhost:6379/0
VERITY_APP_URL=http://localhost:3000
# Fernet key for secrets at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VERITY_SECRET_KEY=
VERITY_EMAIL_BACKEND=smtp
VERITY_SMTP_HOST=localhost
VERITY_SMTP_PORT=1025
VERITY_ADMIN_EMAIL=admin@example.com
VERITY_ADMIN_PASSWORD=
# Production only
VERITY_SESSION_COOKIE_SECURE=false

# Phase 2: knowledge base and chatbot
# Uploaded documents and chatbot logos (a volume in Docker).
VERITY_STORAGE_DIR=./storage
VERITY_MAX_UPLOAD_MB=25
# Background jobs: "saq" (run `make worker`) or "inline" (tests only).
VERITY_QUEUE=saq
# AI providers: "anthropic" and "voyage", or "fake" for local runs without keys (no provider calls).
VERITY_LLM_PROVIDER=anthropic
VERITY_EMBEDDING_PROVIDER=voyage
VERITY_ANTHROPIC_API_KEY=
VERITY_VOYAGE_API_KEY=
VERITY_DEFAULT_CHAT_MODEL=claude-opus-5-5
# Never enable outside local development: lets the crawler fetch private addresses such as localhost.
VERITY_CRAWL_ALLOW_PRIVATE=false

# Phase 5B: payments
# "mock" (a test checkout page and test portal; nothing is charged) or "stripe".
VERITY_PAYMENT_PROVIDER=mock
# Stripe: a secret (or restricted) key, and the signing secret of the webhook endpoint
#   {VERITY_APP_URL}/api/billing/webhooks/stripe
# subscribed to checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired,
# invoice.paid, invoice.payment_failed, customer.subscription.updated, customer.subscription.deleted and
# charge.refunded. Don't subscribe to invoice.created: Stripe then charges renewals at once instead of an hour later.
# Turn on Stripe Tax and Smart Retries in the Stripe Dashboard.
VERITY_STRIPE_SECRET_KEY=
VERITY_STRIPE_WEBHOOK_SECRET=
# A failed renewal keeps tickets, email and forms open (AI pauses) this many days while payment is retried.
VERITY_PAST_DUE_GRACE_DAYS=14

# Client IPs for rate limits: X-Forwarded-For is only believed from these proxies (JSON list of CIDRs).
VERITY_TRUSTED_PROXIES=["127.0.0.1/32", "::1/128"]

# The public landing page (served by the web app at / and /es /de /fr /it /ar).
# Address used in canonical links, hreflang and the sitemap (web app; falls back to VERITY_APP_URL).
VERITY_SITE_URL=
# Its contact form emails this address (a support mailbox you have connected to a workspace, so each message becomes
# a ticket for the visitor). Leave empty to turn the form off.
VERITY_CONTACT_EMAIL=
# The address those messages are sent from (default: the address in VERITY_EMAIL_FROM). Mail from it has its requester
# taken from Reply-To. It must not be one of the workspace's own mailbox addresses.
VERITY_CONTACT_FROM=
